// Basic: only counting & printing
(13566 /* replace this later */)splat,num_1,add,write/local
\"Kills: ",read/local,string/iota,add,print
event/read,num_1,read/local,replace,event/write

// MK2: auto anger nearby monsters (and kill on sight) if sneaking
// Requires: hexparse, hexautomata, moreiotas, hexal, hexoverpowered
([#is_sneaking
  ([entity_pos/foot,duplicate
  duplicate,sentinel/create/great,\,16,zone_entity/monster
  (duplicate,num_1,factor_cut,pop)swap,for_each]pop)
  splat,if,eval
]13566 /* replace this later */)
splat,num_1,add,write/local,eval
\"Kills: ",read/local,string/iota,add,print
event/read,num_2,read/local,replace,event/write

